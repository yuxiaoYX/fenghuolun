FENGHUOLUN_HTTP_ADDR=:8088
FENGHUOLUN_SQLITE_PATH=./data/fenghuolun.db
FENGHUOLUN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# 复制为本目录 .env（已 gitignore）。进程环境变量优先于 .env。
# 加密库内 refresh/access/VIN。至少 32 字节随机串。不要提交真实值。
FENGHUOLUN_TOKEN_KEK=
# 续航/电压默认保持 —。对照官方 App 后才可开候选 /10：
# FENGHUOLUN_NETA_SCALE=candidate
# 仅库中无管理员时创建第一位。不要提交真实密码。
# FENGHUOLUN_ADMIN_BOOTSTRAP_USER=admin
# FENGHUOLUN_ADMIN_BOOTSTRAP_PASSWORD=
# 可选只读定时同步。空/off/0 关闭。例：15m。只换票并拉车况/能耗，不下发车控。
# 空库时写入 app_settings；之后以管理端「设置」为准（热替换，不必改这里重启）。
# FENGHUOLUN_CRON_SYNC=
# 可选。托管管理端构建产物（pnpm --dir apps/admin build）。空则不托管，开发用 Vite :5173。
# FENGHUOLUN_ADMIN_DIR=../apps/admin/dist
