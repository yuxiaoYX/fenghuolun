# 复制为 .env 后按需修改：  cp .env.example .env
# 不复制也可以启动：容器会在数据目录自动生成密钥和首次管理员密码。

# 镜像标签。生产建议钉死版本，例如 v0.1.0
IMAGE_TAG=latest

# 宿主机端口映射。生产若前面有反向代理，改成 127.0.0.1:18088:8088
FENGHUOLUN_PUBLISH=8088:8088

# 数据目录（SQLite、自动生成的 token.kek、admin-bootstrap.txt）
FENGHUOLUN_DATA_DIR=./data

# 凭证加密主密钥。至少 32 字节随机串。留空则首次启动写入 data/token.kek
# 丢失后旧绑定无法解密，只能让车主重新绑定。不要提交真实值。
FENGHUOLUN_TOKEN_KEK=

# 浏览器 CORS。同端口托管车主 H5 + 管理端时可留空；独立域名填 https://你的域名
# 本机 127.0.0.1 / localhost 端口始终放行。空库写入设置表，之后以后台为准。
FENGHUOLUN_CORS_ORIGINS=

# 仅空库创建第一位管理员。密码留空则首次启动写入 data/admin-bootstrap.txt
FENGHUOLUN_ADMIN_BOOTSTRAP_USER=admin
FENGHUOLUN_ADMIN_BOOTSTRAP_PASSWORD=

# 对照官方 App 后再开续航/电压候选 /10
# FENGHUOLUN_NETA_SCALE=candidate

# 空库缺省定时同步。之后以管理端「设置」为准（热替换，不必改这里重启）
# FENGHUOLUN_CRON_SYNC=15m

# 后台一点更新（设置页）。默认 compose 已挂 /var/run/docker.sock
# FENGHUOLUN_UPDATE_DISABLE=1
# FENGHUOLUN_CONTAINER_NAME=fenghuolun
