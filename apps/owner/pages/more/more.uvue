<script setup>
	import { ref } from 'vue'
	import {
		ownerRequest,
		sessionOf,
		clearSession,
		bounceIfAuthFailed,
		envelopeOk,
		envelopeData,
		envelopeErrorCode,
		dashUnknown,
		formatChinaTime,
		themeClassOf,
		padBoxStyle,
		pageWrapStyle,
		applyThemeChrome,
		themeOf,
		setTheme
	} from '../../common/api.uts'

	const themeClass = ref(themeClassOf())
	const padStyle = ref('')
	const wrapStyle = ref('')
	const isDark = ref(false)
	const bound = ref(false)
	const loggedIn = ref(false)
	const carTitle = ref('尚未绑定')
	const carSub = ref('')
	const syncText = ref('')
	const syncOk = ref(true)
	const nickname = ref('')

	const pick = (obj, key) => {
		if (obj == null) {
			return null
		}
		return obj[key]
	}

	const load = async () => {
		if (sessionOf() == '') {
			loggedIn.value = false
			bound.value = false
			carTitle.value = '尚未登录'
			carSub.value = '登录后即可管理您的哪吒 L'
			syncText.value = ''
			return
		}
		loggedIn.value = true
		const res = await ownerRequest('GET', '/api/v1/owner/vehicle', null)
		if (envelopeOk(res) == true) {
			const early = envelopeData(res)
			if (early != null && early['bound'] == false) {
				bound.value = false
				carTitle.value = '尚未绑定'
				carSub.value = '账号已登录，请绑定官方车辆'
				syncText.value = ''
				return
			}
		}
		if (envelopeOk(res) == false) {
			if (envelopeErrorCode(res) == 'unbound') {
				bound.value = false
				carTitle.value = '尚未绑定'
				carSub.value = '短信验证码或手填 Token 均可绑定'
				syncText.value = ''
				return
			}
			if (bounceIfAuthFailed(res) == true) {
				loggedIn.value = false
				bound.value = false
				carTitle.value = '尚未登录'
				carSub.value = '登录后即可管理您的哪吒 L'
				syncText.value = ''
				return
			}
			bound.value = false
			carTitle.value = '会话失效'
			carSub.value = '请重新登录或绑定'
			syncText.value = ''
			return
		}
		bound.value = true
		const d = envelopeData(res)
		const model = pick(d, 'modelName')
		const trim = pick(d, 'trim')
		const nick = pick(d, 'nickname')

		if (nick != null && nick != '') {
			nickname.value = '' + nick
			carTitle.value = '' + nick
		} else {
			nickname.value = ''
			carTitle.value = model == null ? '我的爱车' : '' + model
		}

		if (trim != null && trim != '') {
			carSub.value = '' + (model == null ? '' : model + ' · ') + trim
		} else if (model != null) {
			carSub.value = '' + model
		} else {
			carSub.value = '哪吒 L 纯电/增程'
		}

		syncText.value = '检查连接中...'
		syncOk.value = true
		const sync = await ownerRequest('GET', '/api/v1/owner/sync/latest', null)
		if (envelopeOk(sync) == true) {
			const s = envelopeData(sync)
			const status = dashUnknown(pick(s, 'status'))
			const at = formatChinaTime(pick(s, 'syncedAt'))
			if (status == 'auth_failed' || status == 'token_invalid') {
				syncText.value = '官方凭证已失效 · 请更换绑定'
				syncOk.value = false
			} else {
				syncText.value = '上次同步 ' + at
				syncOk.value = true
			}
		} else {
			syncText.value = '暂时无法确认同步状态'
			syncOk.value = false
		}
	}

	const goLogin = () => {
		uni.navigateTo({
			url: '/pages/login/login'
		})
	}

	const goBind = () => {
		if (sessionOf() == '') {
			goLogin()
			return
		}
		uni.navigateTo({
			url: '/pages/bind/bind'
		})
	}

	const goAccountPhone = () => {
		if (sessionOf() == '') {
			goLogin()
			return
		}
		uni.navigateTo({
			url: '/pages/account/account'
		})
	}

	// 跳转全部补能记录独立二级页面
	const goFillsAll = () => {
		uni.navigateTo({
			url: '/pages/fills/all'
		})
	}

	// 跳转车况历史快照独立二级页面
	const goHistory = () => {
		if (bound.value == false) {
			goBind()
			return
		}
		uni.navigateTo({
			url: '/pages/history/history'
		})
	}

	const editNick = () => {
		if (bound.value == false) {
			return
		}
		uni.showModal({
			title: '修改车辆备注',
			editable: true,
			placeholderText: '为您的爱车起个好记的昵称',
			content: nickname.value,
			success: async (res) => {
				if (res.confirm != true) {
					return
				}
				const nameVal = '' + res.content
				const out = await ownerRequest('PUT', '/api/v1/owner/vehicle', {
					nickname: nameVal
				})
				if (envelopeOk(out) == true) {
					uni.showToast({
						title: '备注已更新',
						icon: 'success'
					})
					load()
					return
				}
				if (bounceIfAuthFailed(out) == false) {
					uni.showToast({
						title: '备注更新失败',
						icon: 'none'
					})
				}
			}
		})
	}

	const confirmLogout = () => {
		uni.showModal({
			title: '退出登录',
			content: '退出仅清理当前手机端登录会话，不会解绑官方车辆。确认退出吗？',
			success: async (res) => {
				if (res.confirm != true) {
					return
				}
				if (sessionOf() != '') {
					await ownerRequest('POST', '/api/v1/owner/logout', null)
				}
				clearSession()
				loggedIn.value = false
				bound.value = false
				carTitle.value = '尚未登录'
				carSub.value = '登录后即可管理您的哪吒 L'
				syncText.value = ''
				uni.showToast({
					title: '已退出登录',
					icon: 'none'
				})
			}
		})
	}

	const confirmUnbind = () => {
		uni.showModal({
			title: '解除官方绑定',
			content: '将删除官方车辆授权凭证。风火轮账号与能耗历史依然保留。确认解绑吗？',
			confirmColor: '#DC2626',
			success: async (res) => {
				if (res.confirm != true) {
					return
				}
				if (sessionOf() != '') {
					await ownerRequest('POST', '/api/v1/owner/unbind', null)
				}
				clearSession()
				loggedIn.value = false
				bound.value = false
				carTitle.value = '尚未登录'
				carSub.value = '登录后即可管理您的哪吒 L'
				syncText.value = ''
				uni.showToast({
					title: '已解除绑定',
					icon: 'none'
				})
			}
		})
	}

	const tapAbout = () => {
		uni.showModal({
			title: '关于风火轮',
			content: '风火轮 v0.1.4\n哪吒 L 车友自制开源座舱与记账工具箱。\n纯私有服务守护车辆历史与能耗账本，无第三方数据上报。',
			showCancel: false
		})
	}

	const applyChrome = () => {
		themeClass.value = themeClassOf()
		padStyle.value = padBoxStyle(true)
		wrapStyle.value = pageWrapStyle()
		isDark.value = themeOf() != 'light'
		applyThemeChrome()
	}

	const chooseTheme = (t : string) => {
		setTheme(t)
		applyChrome()
	}

	onLoad(() => {
		applyChrome()
	})

	onShow(() => {
		applyChrome()
		load()
	})
</script>

<template>
	<view class="page-wrap" :class="themeClass" :style="wrapStyle">
		<scroll-view class="scroller" direction="vertical">
			<view class="pad" :style="padStyle">

				<!-- 状态 1：未登录卡片 -->
				<view class="cockpit-card hero-login-card" v-if="!loggedIn" @click="goLogin">
					<view class="hero-left">
						<view class="hero-logo-box">
							<image class="hero-logo" src="/static/logo.png" mode="aspectFit" />
						</view>
						<view class="hero-texts">
							<text class="hero-title">点击登录风火轮</text>
							<text class="hero-sub">开启爱车远程车况与能耗账本</text>
						</view>
					</view>
					<text class="arrow-chev">›</text>
				</view>

				<!-- 状态 2：已登录未绑定卡片 -->
				<view class="cockpit-card unbound-card" v-if="loggedIn && !bound">
					<view class="unbound-top">
						<text class="unbound-badge">待绑定爱车</text>
						<text class="unbound-title">尚未绑定哪吒官方车辆</text>
						<text class="unbound-desc">绑定后即可实时同步车辆状态、电量与续航</text>
					</view>
					<view class="unbound-btn" @click="goBind">
						<text class="unbound-btn-txt">前往绑定</text>
					</view>
				</view>

				<!-- 状态 3：已绑定车辆座舱卡片 (高质感，带风火轮Logo火苗块) -->
				<view class="cockpit-card vehicle-card" v-if="loggedIn && bound">
					<view class="v-top-row">
						<view class="v-main-info">
							<view class="v-logo-box">
								<text class="v-logo-icon">🔥</text>
							</view>
							<view class="v-meta">
								<view class="v-nick-row">
									<text class="v-nick">{{ carTitle }}</text>
									<text class="v-edit-tag" @click="editNick">改备注</text>
								</view>
								<text class="v-sub">{{ carSub }}</text>
							</view>
						</view>
						<text class="v-status-badge" :class="syncOk ? 'status-ok' : 'status-err'">
							{{ syncOk ? '连接正常' : '凭证失效' }}
						</text>
					</view>

					<view class="v-foot-row">
						<text class="v-foot-lbl">官方云凭证状态: {{ syncOk ? '良好' : '异常' }}</text>
						<text class="v-foot-time">{{ syncText }}</text>
					</view>
				</view>

				<!-- 🧰【数据与实用工具箱】 (独立二级页面核心入口) -->
				<text class="sec-label">数据与记录资产</text>
				<view class="group-box">
					<!-- 车况历史快照 (独立页面) -->
					<view class="menu-item" @click="goHistory">
						<view class="menu-left">
							<view class="menu-icon icon-history">
								<text class="emoji-txt">🕒</text>
							</view>
							<view class="menu-texts">
								<text class="menu-title">车况历史快照</text>
								<text class="menu-desc">私有服务已归档的历次电量与行驶快照</text>
							</view>
						</view>
						<text class="arrow-chev">›</text>
					</view>

					<view class="menu-divider"></view>

					<!-- 全部补能明细账本 (独立页面) -->
					<view class="menu-item" @click="goFillsAll">
						<view class="menu-left">
							<view class="menu-icon icon-fills">
								<text class="emoji-txt">⚡</text>
							</view>
							<view class="menu-texts">
								<text class="menu-title">全部补能记录明细</text>
								<text class="menu-desc">查看全部充电与加油实付历史明细</text>
							</view>
						</view>
						<text class="arrow-chev">›</text>
					</view>
				</view>

				<!-- 🎨【座舱外观设置】 -->
				<text class="sec-label">座舱视觉主题</text>
				<view class="theme-seg-wrap">
					<view class="theme-item" :class="!isDark ? 'theme-active' : ''" @click="chooseTheme('light')">
						<text class="theme-icon">☀️</text>
						<text class="theme-name" :class="!isDark ? 'theme-name-active' : ''">浅色 · 晨雾提车</text>
					</view>
					<view class="theme-item" :class="isDark ? 'theme-active' : ''" @click="chooseTheme('dark')">
						<text class="theme-icon">🌙</text>
						<text class="theme-name" :class="isDark ? 'theme-name-active' : ''">深色 · 座舱夜航</text>
					</view>
				</view>

				<!-- 🔒【账号与安全】 -->
				<view v-if="loggedIn">
					<text class="sec-label">账号与安全</text>
					<view class="group-box">
						<view class="menu-item" @click="goAccountPhone">
							<view class="menu-left">
								<view class="menu-icon icon-phone">
									<text class="emoji-txt">📱</text>
								</view>
								<view class="menu-texts">
									<text class="menu-title">修改风火轮手机号</text>
									<text class="menu-desc">用于短信验证码与账号认证</text>
								</view>
							</view>
							<text class="arrow-chev">›</text>
						</view>

						<view class="menu-divider" v-if="bound"></view>

						<view class="menu-item" v-if="bound" @click="goBind">
							<view class="menu-left">
								<view class="menu-icon icon-bind">
									<text class="emoji-txt">🔄</text>
								</view>
								<view class="menu-texts">
									<text class="menu-title">更换官方车辆绑定</text>
									<text class="menu-desc">重换官方授权凭证或绑定新车辆</text>
								</view>
							</view>
							<text class="arrow-chev">›</text>
						</view>
					</view>
				</view>

				<!-- ℹ️【关于与退出】 -->
				<text class="sec-label">关于</text>
				<view class="group-box">
					<view class="menu-item" @click="tapAbout">
						<view class="menu-left">
							<view class="menu-icon icon-about">
								<text class="emoji-txt">ℹ️</text>
							</view>
							<view class="menu-texts">
								<text class="menu-title">关于风火轮</text>
								<text class="menu-desc">v0.1.4 · 哪吒 L 车友自制开源工具箱</text>
							</view>
						</view>
						<text class="arrow-chev">›</text>
					</view>
				</view>

				<!-- 账号操作按钮（退出 / 解除绑定） -->
				<view class="danger-zone" v-if="loggedIn">
					<button class="action-btn btn-logout" @click="confirmLogout">退出登录</button>
					<button class="action-btn btn-unbind" v-if="bound" @click="confirmUnbind">解除车辆绑定</button>
				</view>

				<view class="page-end"></view>
			</view>
		</scroll-view>
	</view>
</template>

