	.oil-color {
		color: #D97706;
	}
	.font-bold {
		font-weight: 700;
	}

	/* 7日柱状图 */
	.chart-box {
		flex-direction: row;
		justify-content: space-between;
		align-items: flex-end;
		height: 110px;
		padding-top: 10px;
	}
	.bar-col {
		flex: 1;
		align-items: center;
		justify-content: flex-end;
	}
	.bar-val {
		font-size: 10px;
