	}
	.bar-day {
		font-size: 11px;
		color: var(--text-muted, #94A3B8);
		margin-top: 6px;
	}

	/* 最近记录专区 */
	.section-card {
		margin-top: 4px;
	}
	.section-head {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 10px;
		padding: 0 2px;
	}
	.section-title {
		font-size: 13px;
		font-weight: 600;
		color: var(--text-sub, #64748B);
		letter-spacing: 0.5px;
	}
	.link-all-btn {
		padding: 4px 6px;
	}
	.link-all-text {
		font-size: 12px;
		font-weight: 700;
		color: #FF5722;
	}

	/* 补能卡片 */
	.fills-list {
		flex-direction: column;
		gap: 10px;
	}
	.fill-card {
		background-color: var(--card-bg, #FFFFFF);
		border: 1px solid var(--border-color, rgba(15, 23, 42, 0.08));
		border-radius: 16px;
		padding: 12px 14px;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
	}
	.fill-row-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 6px;
	}
	.fill-title-wrap {
		flex-direction: row;
		align-items: center;
	}
	.fill-icon-box {
		width: 24px;
		height: 24px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 8px;
	}
	.icon-elec {
		background-color: rgba(16, 185, 129, 0.12);
	}
	.icon-oil {
		background-color: rgba(245, 158, 11, 0.12);
	}
	.fill-emoji {
		font-size: 12px;
	}
	.fill-title {
