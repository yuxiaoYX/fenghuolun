<script setup>
	import { ref } from 'vue'
	import { ownerRequest, sessionOf, bounceIfAuthFailed, envelopeOk, envelopeData, themeClassOf, padBoxStyle, pageWrapStyle, applyThemeChrome } from '../../common/api.uts'

	const themeClass = ref(themeClassOf())
	const padStyle = ref('')
	const wrapStyle = ref('')
	const id = ref('')
	const kind = ref('charge')
	const paid = ref('')
	const qty = ref('')
	const socStart = ref('')
	const socEnd = ref('')
	const fuelStart = ref('')
	const fuelEnd = ref('')
	const odoEnd = ref('')
	const note = ref('')
	const hint = ref('')
	const whenTxt = ref('')
	const eventTime = ref('')
	const startedTxt = ref('')
	const isDraft = ref(false)
	const isAuto = ref(false)
	const sourceTxt = ref('手工记录')
	const unitTxt = ref('')
	const err = ref('')
	const busy = ref(false)

	const pick = (obj, key) => {
		if (obj == null) {
			return null
		}
		return obj[key]
	}

	const numTxt = (v) => {
		if (v == null) {
			return ''
		}
		return '' + v
	}

	const parseNum = (raw : string) => {
		const t = raw.trim()
		if (t == '') {
			return null
		}
		const n = parseFloat(t)
		if (n != n) {
			return null
		}
		return n
	}

	const applyFill = (d) => {
		kind.value = pick(d, 'kind') == 'refuel' ? 'refuel' : 'charge'
		paid.value = numTxt(pick(d, 'paidCny'))
		if (kind.value == 'charge') {
			qty.value = numTxt(pick(d, 'energyKwh'))
		} else {
			qty.value = numTxt(pick(d, 'liters'))
		}
		socStart.value = numTxt(pick(d, 'socStart'))
		socEnd.value = numTxt(pick(d, 'socEnd'))
		fuelStart.value = numTxt(pick(d, 'fuelStart'))
		fuelEnd.value = numTxt(pick(d, 'fuelEnd'))
		odoEnd.value = numTxt(pick(d, 'odoEnd'))
		note.value = pick(d, 'note') == null ? '' : '' + pick(d, 'note')
		const finished = pick(d, 'finishedAt')
		whenTxt.value = finished == null ? '' : '' + finished
		eventTime.value = whenTxt.value
		const started = pick(d, 'startedAt')
		startedTxt.value = started == null ? '' : '' + started
		isDraft.value = pick(d, 'status') == 'draft'
		isAuto.value = pick(d, 'source') == 'auto'
		sourceTxt.value = isAuto.value ? '系统识别' : '手工记录'
		const unit = pick(d, 'unitCny')
		if (unit != null) {
			unitTxt.value = kind.value == 'refuel' ? '折合 ' + unit + ' 元/升' : '折合 ' + unit + ' 元/度'
		} else {
			unitTxt.value = ''
		}
		const st = pick(d, 'status')
		if (st == 'draft') {
			hint.value = isAuto.value ? '系统根据历史快照识别出的补能过程。请补充账单，状态值可改。' : '账单信息未补齐，可以现在填写，也可以之后再补。'
		} else {
			hint.value = '已记账。改实付后保存。'
		}
		setTitle()
	}

	const setTitle = () => {
		uni.setNavigationBarTitle({
			title: kind.value == 'refuel' ? '加油' : '充电'
		})
	}

	const prefillLatest = async () => {
		isDraft.value = false
		isAuto.value = false
		sourceTxt.value = '手工记录'
		startedTxt.value = ''
		whenTxt.value = ''
		eventTime.value = ''
		odoEnd.value = ''
		socStart.value = ''
		socEnd.value = ''
		fuelStart.value = ''
		fuelEnd.value = ''
		if (kind.value == 'charge') {
			hint.value = '没有识别到历史充电过程。请按账单填写时间，电量状态可留空。'
		} else {
			hint.value = '没有识别到历史加油过程。请按账单填写时间，油量状态可留空。'
		}
		setTitle()
	}

	const load = async () => {
		err.value = ''
		if (sessionOf() == '') {
			err.value = '尚未绑定'
			return
		}
		if (id.value != '') {
			const res = await ownerRequest('GET', '/api/v1/owner/fills/' + id.value, null)
			if (envelopeOk(res) == false) {
				if (bounceIfAuthFailed(res) == true) {
					return
				}
				err.value = '没有这条记录'
				return
			}
			applyFill(envelopeData(res))
			return
		}
		await prefillLatest()
	}

	const save = async () => {
		err.value = ''
		const p = parseNum(paid.value)
		const q = parseNum(qty.value)
		if (paid.value.trim() != '' && p == null) {
			err.value = '实付请填数字'
			return
		}
		if (qty.value.trim() != '' && q == null) {
			err.value = kind.value == 'charge' ? '电量请填数字' : '升数请填数字'
			return
		}
		const body : UTSJSONObject = {
			kind: kind.value,
			paidCny: p,
			odoEnd: parseNum(odoEnd.value),
			finishedAt: eventTime.value.trim(),
			note: note.value
		}
		if (kind.value == 'charge') {
			body['energyKwh'] = q
			body['socStart'] = parseNum(socStart.value)
			body['socEnd'] = parseNum(socEnd.value)
			body['fuelEnd'] = parseNum(fuelEnd.value)
		} else {
			body['liters'] = q
			body['fuelStart'] = parseNum(fuelStart.value)
			body['fuelEnd'] = parseNum(fuelEnd.value)
			body['socEnd'] = parseNum(socEnd.value)
		}
		busy.value = true
		let res : UTSJSONObject | null = null
		if (id.value == '') {
			res = await ownerRequest('POST', '/api/v1/owner/fills', body)
		} else {
			res = await ownerRequest('PUT', '/api/v1/owner/fills/' + id.value, body)
		}
		busy.value = false
		if (envelopeOk(res) == true) {
			uni.navigateBack({})
			return
		}
		if (bounceIfAuthFailed(res) == true) {
			return
		}
		err.value = '没存上。实付和数字请填合理范围。'
	}

	const setKind = (k : string) => {
		kind.value = k
		unitTxt.value = ''
		setTitle()
		if (k == 'charge') {
			hint.value = '充电：填实付和起止电量。度数可选，用来算单价和容量。'
		} else {
			hint.value = '加油：填实付和加油前后油量。升数可选，用来算单价。'
		}
	}

	const drop = async () => {
		if (id.value == '') {
			uni.navigateBack({})
			return
		}
		busy.value = true
		const res = await ownerRequest('DELETE', '/api/v1/owner/fills/' + id.value, null)
		busy.value = false
		if (envelopeOk(res) == true || bounceIfAuthFailed(res) == true) {
			uni.navigateBack({})
			return
		}
		err.value = '没删掉'
	}

	onLoad((q) => {
		themeClass.value = themeClassOf()
		padStyle.value = padBoxStyle(false)
		wrapStyle.value = pageWrapStyle()
		applyThemeChrome()
		if (q != null && q['id'] != null && q['id'] != '') {
			id.value = '' + q['id']
		}
		if (q != null && q['kind'] == 'refuel') {
			kind.value = 'refuel'
		}
		setTitle()
		load()
	})
</script>

<template>
	<view class="page-wrap" :class="themeClass" :style="wrapStyle">
		<scroll-view class="scroller" direction="vertical">
			<view class="pad" :style="padStyle">
				<text class="meta">{{ hint }}</text>
				<view class="fill-origin" :class="isDraft == true ? 'fill-origin-auto' : ''">
					<text class="fill-origin-title">{{ sourceTxt }} · {{ isDraft == true ? '待补账单' : '只保存你确认的信息' }}</text>
					<text class="fill-origin-text" v-if="isAuto == true">历史快照识别时间：{{ startedTxt }} → {{ whenTxt }}。请补充账单，状态值可以手动修正。</text>
					<text class="fill-origin-text" v-else-if="isDraft == true">账单金额尚未填写，可以补录；系统不会推测补能前状态。</text>
					<text class="fill-origin-text" v-else>没有匹配到历史补能过程，系统不会用当前车辆状态代替补能前状态。</text>
				</view>
				<view class="theme-row">
					<view class="theme-pill" :class="kind == 'charge' ? 'theme-pill-on' : ''" @click="setKind('charge')">
						<text class="theme-pill-txt" :class="kind == 'charge' ? 'theme-pill-on-txt' : ''">充电</text>
					</view>
					<view class="theme-gap"></view>
					<view class="theme-pill" :class="kind == 'refuel' ? 'theme-pill-on' : ''" @click="setKind('refuel')">
						<text class="theme-pill-txt" :class="kind == 'refuel' ? 'theme-pill-on-txt' : ''">加油</text>
					</view>
				</view>

				<view class="group">
					<view class="form-line">
						<text class="form-k">日期时间</text>
						<input class="form-in" v-model="eventTime" placeholder="YYYY-MM-DD HH:mm" />
					</view>
					<view class="hair"></view>
					<view class="form-line">
						<text class="form-k">补能时里程</text>
						<input class="form-in" v-model="odoEnd" placeholder="可改" />
						<text class="form-u-wide">公里</text>
					</view>
				</view>

				<view class="group" v-if="kind == 'charge'">
					<view class="form-line">
						<text class="form-k">账单实付</text>
						<input class="form-in" v-model="paid" placeholder="可后补" />
						<text class="form-u">元</text>
					</view>
					<view class="hair"></view>
					<view class="form-line">
						<text class="form-k">账单电量</text>
						<input class="form-in" v-model="qty" placeholder="枪上度数，可后补" />
						<text class="form-u">度</text>
					</view>
					<view class="hair" v-if="unitTxt.length > 0"></view>
					<view class="form-line" v-if="unitTxt.length > 0">
						<text class="form-k">折合电价</text>
						<text class="form-val">{{ unitTxt }}</text>
					</view>
					<view class="hair"></view>
					<view class="form-line">
						<text class="form-k">开始充电时</text>
						<input class="form-in" v-model="socStart" placeholder="可改" />
						<text class="form-u">%</text>
					</view>
					<view class="hair"></view>
					<view class="form-line">
						<text class="form-k">结束充电时</text>
						<input class="form-in" v-model="socEnd" placeholder="可改" />
						<text class="form-u">%</text>
					</view>
					<view class="hair"></view>
					<view class="form-line">
						<text class="form-k">当时油量</text>
						<input class="form-in" v-model="fuelEnd" placeholder="可改" />
						<text class="form-u">%</text>
					</view>
				</view>

				<view class="group" v-if="kind == 'refuel'">
					<view class="form-line">
						<text class="form-k">账单实付</text>
						<input class="form-in" v-model="paid" placeholder="可后补" />
						<text class="form-u">元</text>
					</view>
					<view class="hair"></view>
					<view class="form-line">
						<text class="form-k">账单升数</text>
						<input class="form-in" v-model="qty" placeholder="机显升数，可后补" />
						<text class="form-u">升</text>
					</view>
					<view class="hair" v-if="unitTxt.length > 0"></view>
					<view class="form-line" v-if="unitTxt.length > 0">
						<text class="form-k">折合油价</text>
						<text class="form-val">{{ unitTxt }}</text>
					</view>
					<view class="hair"></view>
					<view class="form-line">
						<text class="form-k">加油前油量</text>
						<input class="form-in" v-model="fuelStart" placeholder="可改" />
						<text class="form-u">%</text>
					</view>
					<view class="hair"></view>
					<view class="form-line">
						<text class="form-k">加油后油量</text>
						<input class="form-in" v-model="fuelEnd" placeholder="可改" />
						<text class="form-u">%</text>
					</view>
					<view class="hair"></view>
					<view class="form-line">
						<text class="form-k">当时电量</text>
						<input class="form-in" v-model="socEnd" placeholder="可改" />
						<text class="form-u">%</text>
					</view>
				</view>

				<view class="group">
					<view class="form-line">
						<text class="form-k">备注</text>
						<input class="form-in" v-model="note" placeholder="可选" />
					</view>
				</view>
				<button class="primary" :disabled="busy == true" @click="save">{{ isDraft == true ? '保存账单' : '保存记录' }}</button>
				<button class="ghost" :disabled="busy == true" @click="drop">{{ id == '' ? '取消' : '删除' }}</button>
				<text class="err" v-if="err.length > 0">{{ err }}</text>
				<view class="page-end"></view>
			</view>
		</scroll-view>
	</view>
</template>
