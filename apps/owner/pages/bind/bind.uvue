		padding-bottom: 4px;
		padding-left: 4px;
		margin-bottom: 14px;
	}
	.mode-seg-pill {
		flex: 1;
		min-height: 38px;
		border-radius: 9px;
		align-items: center;
		justify-content: center;
	}
	.mode-seg-active {
		background-color: var(--fhl-pan);
		border-width: 1px;
		border-style: solid;
		border-color: var(--fhl-line);
	}
	.mode-seg-txt {
		font-size: 12px;
		font-weight: 600;
		color: var(--fhl-mut);
	}
	.mode-seg-active-txt {
		color: var(--fhl-brand);
		font-weight: 700;
	}
	.tip-card {
		padding-top: 10px;
		padding-right: 12px;
		padding-bottom: 10px;
		padding-left: 12px;
		border-radius: 12px;
		background-color: var(--fhl-pan2);
		margin-bottom: 12px;
	}
	.tip-txt {
		font-size: 12px;
		color: var(--fhl-mut);
		line-height: 1.45em;
	}
	.auth-card {
		background-color: var(--fhl-pan);
		border-width: 1px;
		border-style: solid;
		border-color: var(--fhl-line);
		border-radius: 18px;
		overflow: hidden;
		margin-bottom: 14px;
	}
	.auth-token-card {
		padding-top: 14px;
		padding-right: 14px;
		padding-bottom: 14px;
		padding-left: 14px;
	}
	.token-hint-txt {
		font-size: 12px;
		font-weight: 600;
		color: var(--fhl-ink);
		margin-bottom: 8px;
	}
	.token-area {
		width: 100%;
		height: 96px;
		padding-top: 8px;
		padding-right: 10px;
		padding-bottom: 8px;
		padding-left: 10px;
		border-radius: 12px;
		background-color: var(--fhl-pan2);
		font-size: 12px;
		color: var(--fhl-ink);
		border-width: 1px;
		border-style: solid;
		border-color: var(--fhl-line);
	}
	.auth-row {
		flex-direction: row;
		align-items: center;
		min-height: 54px;
		padding-left: 16px;
		padding-right: 14px;
	}
	.auth-label {
		width: 60px;
		font-size: 14px;
		font-weight: 600;
		color: var(--fhl-ink);
	}
	.auth-input {
		flex: 1;
		height: 44px;
		font-size: 15px;
		font-weight: 500;
		color: var(--fhl-ink);
		border-width: 0px;
		background-color: transparent;
	}
	.auth-code-pill {
		padding-top: 6px;
		padding-right: 12px;
		padding-bottom: 6px;
		padding-left: 12px;
		border-radius: 10px;
		background-color: rgba(255, 106, 61, 0.12);
		margin-left: 8px;
	}
	.auth-code-pill-dis {
		background-color: var(--fhl-pan2);
	}
	.auth-code-txt {
		font-size: 12px;
		font-weight: 700;
		color: var(--fhl-brand);
	}
	.auth-code-txt-dis {
		color: var(--fhl-faint);
	}
	.help-toggle-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
