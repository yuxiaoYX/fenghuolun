<script setup>
	import { ref } from 'vue'
	import FillModal from '../../components/fill-modal/fill-modal.uvue'
	import {
		ownerRequest,
		sessionOf,
		dashNum,
		dashYuan,
		timeLine,
		bounceIfAuthFailed,
		envelopeOk,
		envelopeData,
		themeClassOf,
		padBoxStyle,
		pageWrapStyle,
		applyThemeChrome,
		fabStyle
	} from '../../common/api.uts'

	const themeClass = ref(themeClassOf())
	const padStyle = ref('')
	const wrapStyle = ref('')
	const fabBox = ref(fabStyle())
	const fillModalRef = ref<any>(null)

	const weekKwh = ref('—')
	const fuelDelta = ref('—')
	const fuelNote = ref('需要至少两笔快照才能记油')
	const acShare = ref('—')
	const note = ref('')
	const freshText = ref('尚未更新')
	const elecCost = ref('—')
	const oilCost = ref('—')
	const weekCost = ref('官方按日 kWh 合计')

	type EnergyBar = {
		h : number
		val : string
		day : string
		on : boolean
	}

	type FillRec = {
		id : string
		title : string
		amt : string
		oil : boolean
		started : string
		when : string
		state : string
		unit : string
		action : string
		draft : boolean
		icon : string
		amount : number
		amountPresent : boolean
		quantity : number
		beforeVal : string
		afterVal : string
		noteText : string
	}

	const eleBars = ref<EnergyBar[]>([] as EnergyBar[])
	const recentFills = ref<FillRec[]>([] as FillRec[])
	const hasEleChart = ref(false)

	const pick = (obj, key) => {
		if (obj == null) {
			return null
		}
		return obj[key]
	}

	const displayTime = (raw : string) : string => {
		if (raw.length >= 16) {
			return raw.substring(0, 16)
		}
		return raw
	}

	const shortState = (before : string, after : string, isOil : boolean) : string => {
		const label = isOil ? '油量 ' : '电量 '
		const start = before == '' ? '—' : before + '%'
		const end = after == '' ? '—' : after + '%'
		if (before == '' && after == '') {
			return '补能前后状态待确认'
		}
		return label + start + ' → ' + end
	}

	const numText = (v) : string => {
		if (v == null) {
			return ''
		}
		return '' + v
	}

	const toBars = (vals : number[], labels : string[]) : EnergyBar[] => {
		const out : EnergyBar[] = []
		let max = 0
		let i = 0
		while (i < vals.length) {
			const n = vals[i]
			if (n != null && n > max) {
				max = n
			}
			i = i + 1
		}
		if (max <= 0) {
			max = 1
		}
		i = 0
		while (i < vals.length) {
			const n = vals[i]
			let h = 8
			if (n != null && n > 0) {
				h = Math.round(n / max * 60)
				if (h < 8) {
					h = 8
				}
			}
			out.push({
				h: h,
				val: n != null ? n.toFixed(1) : '0',
				day: i < labels.length ? labels[i] : '—',
				on: i == vals.length - 1
			})
			i = i + 1
		}
		return out
	}

	const load = async () => {
		if (sessionOf() == '') {
			recentFills.value = [] as FillRec[]
			eleBars.value = [] as EnergyBar[]
			hasEleChart.value = false
			weekKwh.value = '—'
			fuelDelta.value = '—'
			note.value = '尚未登录'
			freshText.value = '去「我的」登录以查看能耗'
			return
		}
		const res = await ownerRequest('GET', '/api/v1/owner/energy', null)
		if (envelopeOk(res) == false) {
			if (bounceIfAuthFailed(res) == true) {
				return
			}
			note.value = '拉取能耗数据失败'
			return
		}
		const data = envelopeData(res)
		note.value = pick(data, 'note') != null ? '' + pick(data, 'note') : ''

		const spend = pick(data, 'spend')
		elecCost.value = dashYuan(pick(spend, 'chargePaidCny'))
		oilCost.value = dashYuan(pick(spend, 'refuelPaidCny'))
		const useCost = pick(spend, 'elecUseCostCny')
		if (useCost != null) {
			weekCost.value = dashYuan(useCost) + ' · 按实填电费折合'
		} else {
			weekCost.value = '官方按日 kWh 合计'
		}

		const official = pick(data, 'official')
		freshText.value = timeLine(pick(official, 'fetchedAt'), null)
		weekKwh.value = dashNum(pick(official, 'totalKwh'), '')

		const days = pick(official, 'days')
		const eleVals : number[] = []
		const eleLabels : string[] = []
		if (days != null && days.length > 0) {
			const latest = days[days.length - 1]
			const total0 = pick(latest, 'totalKwh')
			const ac = pick(latest, 'acKwh')
			if (total0 != null && ac != null && total0 > 0) {
				acShare.value = '' + Math.round(ac / total0 * 100) + '%'
			}
			let start = 0
			if (days.length > 7) {
				start = days.length - 7
			}
			let i = start
			while (i < days.length) {
				const kwh = pick(days[i], 'totalKwh')
				if (kwh == null) {
					eleVals.push(0)
				} else {
					eleVals.push(parseFloat('' + kwh))
				}
				const countTime = pick(days[i], 'countTime')
				eleLabels.push(countTime == null ? '—' : ('' + countTime).substring(5, 10))
				i = i + 1
			}
		}
		if (eleVals.length > 0) {
			eleBars.value = toBars(eleVals, eleLabels)
			hasEleChart.value = true
		} else {
			hasEleChart.value = false
		}

		const fuel = pick(data, 'fuel')
		if (fuel != null && fuel.length > 0) {
			const last = fuel[fuel.length - 1]
			const kind = pick(last, 'kind')
			const delta = pick(last, 'fuelPctDelta')
			fuelDelta.value = dashNum(delta, '%')
			if (kind == 'burn') {
				fuelNote.value = '油量下降，记耗油'
			} else if (kind == 'refuel') {
				fuelNote.value = '加油，不计入耗油'
			} else {
				fuelNote.value = '油量持平或待对照'
			}
		}

		const fills = pick(data, 'fills')
		const recs : FillRec[] = []
		if (fills != null) {
			let fi = 0
			while (fi < fills.length) {
				const row = fills[fi]
				const k = pick(row, 'kind')
				const oil = k == 'refuel'
				const draft = pick(row, 'status') == 'draft'
				const auto = pick(row, 'source') == 'auto'
				const amountPresent = pick(row, 'paidCny') != null
				const amountValue = amountPresent ? parseFloat('' + pick(row, 'paidCny')) : 0
				const quantityValue = oil ? (pick(row, 'liters') == null ? 0 : parseFloat('' + pick(row, 'liters'))) : (pick(row, 'energyKwh') == null ? 0 : parseFloat('' + pick(row, 'energyKwh')))
				let amt = pick(row, 'paidCny') != null ? '¥' + amountValue.toFixed(2) : '待补金额'
				let title = oil ? '加油记账' : '充电记账'
				if (draft && auto) {
					title = oil ? '系统识别 · 加油' : '系统识别 · 充电'
				} else if (pick(row, 'note') != null && ('' + pick(row, 'note')).trim() != '') {
					title = '' + pick(row, 'note')
				}
				const unit = pick(row, 'unitCny')
				const beforeText = oil ? numText(pick(row, 'fuelStart')) : numText(pick(row, 'socStart'))
				const afterText = oil ? numText(pick(row, 'fuelEnd')) : numText(pick(row, 'socEnd'))
				let state = shortState(beforeText, afterText, oil)
				if (quantityValue > 0) {
					state = state + (oil ? ' (加入 ' : ' (充入 ') + quantityValue.toFixed(1) + (oil ? ' L)' : ' kWh)')
				}
				const unitText = unit == null ? '' : '折合 ¥' + parseFloat('' + unit).toFixed(2) + (oil ? '/升' : '/度')
				recs.push({
					id: '' + pick(row, 'id'),
					title: title,
					amt: amt,
					oil: oil,
					started: pick(row, 'startedAt') == null ? '' : displayTime('' + pick(row, 'startedAt')),
					when: pick(row, 'finishedAt') == null ? '' : displayTime('' + pick(row, 'finishedAt')),
					state: state,
					unit: unitText,
					action: draft ? '补充账单 ›' : '已入账 ›',
					draft: draft,
					icon: oil ? '⛽' : '⚡',
					amount: amountValue,
					amountPresent: amountPresent,
					quantity: quantityValue,
					beforeVal: beforeText,
					afterVal: afterText,
					noteText: pick(row, 'note') == null ? '' : '' + pick(row, 'note')
				})
				fi = fi + 1
			}
		}

		recentFills.value = [] as FillRec[]
		let recent = 0
		while (recent < recs.length && recent < 3) {
			recentFills.value.push(recs[recent])
			recent = recent + 1
		}
	}

	// 跳转全部补能记录独立二级页面
	const goAllFills = () => {
		uni.navigateTo({ url: '/pages/fills/all' })
	}

	// 点击右下角 FAB 悬浮球：调用弹窗组件，直接默认弹出充电记账 Modal！
	const tapFab = () => {
		if (fillModalRef.value != null) {
			fillModalRef.value.open('charge', false, null)
		}
	}

	// 点击列表记录：调用弹窗组件回填数据
	const clickFillRec = (rec : FillRec) => {
		if (fillModalRef.value != null) {
			const payload : UTSJSONObject = {
				id: rec.id,
				amount: rec.amount,
				amountPresent: rec.amountPresent,
				quantity: rec.quantity,
				beforeVal: rec.beforeVal,
				afterVal: rec.afterVal,
				noteText: rec.noteText,
				timeTxt: rec.when
			}
			fillModalRef.value.open(rec.oil ? 'refuel' : 'charge', rec.draft, payload)
		}
	}

	const tapHow = () => {
		uni.showModal({
			title: '电耗与油耗计算规则',
			content: '电耗：来自官方每日统计 kWh；\n油耗：私有服务根据快照油量差分计算；\n花费：以您每次充电或加油实付记账为准。',
			showCancel: false
		})
	}

	const applyChrome = () => {
		themeClass.value = themeClassOf()
		padStyle.value = padBoxStyle(true)
		wrapStyle.value = pageWrapStyle()
		fabBox.value = fabStyle()
		applyThemeChrome()
	}

	onLoad(() => {
		applyChrome()
	})

	onShow(() => {
		applyChrome()
		load()
	})
</script>

<template>
	<view class="page-wrap" :class="themeClass" :style="wrapStyle">
		<scroll-view class="scroller" direction="vertical">
			<view class="pad" :style="padStyle">

				<!-- 头部抬头与规则说明 -->
				<view class="energy-header">
					<view class="head-left">
						<text class="page-title">能耗与用车账本</text>
						<text class="page-subtitle">电、油双账分开记 · 花费按次实付</text>
					</view>
					<view class="info-btn" @click="tapHow">
						<text class="info-icon">ℹ️</text>
					</view>
				</view>

				<!-- ⚡【近 7 日用车资产总览大卡】 -->
				<view class="cockpit-card">
					<view class="card-head">
						<text class="card-title">近 7 日用车资产总览</text>
						<text class="card-extra elec-color">暂无里程数据，无法计算</text>
					</view>

					<view class="asset-grid">
						<view class="asset-tile asset-tile-elec">
							<text class="asset-label">官方总用电</text>
							<view class="asset-num-row">
								<text class="asset-num">{{ weekKwh }}</text>
								<text class="asset-unit">kWh</text>
							</view>
							<text class="asset-sub elec-color">{{ weekCost }}</text>
						</view>

						<view class="asset-tile asset-tile-oil">
							<text class="asset-label">账本净耗油</text>
							<view class="asset-num-row">
								<text class="asset-num oil-color">{{ fuelDelta }}</text>
								<text class="asset-unit">油量</text>
							</view>
							<text class="asset-sub oil-color">{{ fuelNote }}</text>
						</view>
					</view>
				</view>

				<!-- 📊【近 7 日用电趋势直方图】 -->
				<view class="cockpit-card" v-if="hasEleChart">
					<view class="card-head">
						<text class="card-title">近 7 日用电趋势 (kWh)</text>
						<text class="card-extra">官方按日统计</text>
					</view>

					<view class="chart-box">
						<view class="bar-col" v-for="(b, idx) in eleBars" :key="idx">
							<text class="bar-val" :class="b.on ? 'elec-color font-bold' : ''">{{ b.val }}</text>
							<view class="bar-slot">
								<view class="bar-fill" :class="b.on ? 'bar-on' : 'bar-off'" :style="'height:' + b.h + 'px'"></view>
							</view>
							<text class="bar-day" :class="b.on ? 'elec-color font-bold' : ''">{{ b.day }}</text>
						</view>
					</view>
				</view>

				<!-- 📝【最近补能记录】 (跳转独立全部记录页面) -->
				<view class="section-card">
					<view class="section-head">
						<text class="section-title">最近补能记录</text>
						<!-- 查看全部记录 (跳转独立页面) -->
						<view class="link-all-btn" @click="goAllFills">
							<text class="link-all-text">查看全部记录 ›</text>
						</view>
					</view>

					<!-- 流水卡片列表 -->
					<view class="fills-list">
						<view class="fill-card" v-for="rec in recentFills" :key="rec.id" @click="clickFillRec(rec)">
							<view class="fill-row-top">
								<view class="fill-title-wrap">
									<view class="fill-icon-box" :class="rec.oil ? 'icon-oil' : 'icon-elec'">
										<text class="fill-emoji">{{ rec.icon }}</text>
									</view>
									<text class="fill-title">{{ rec.title }}</text>
									<text class="draft-badge" v-if="rec.draft">待补账单</text>
								</view>
								<text class="fill-amt" :class="rec.draft ? 'amt-draft' : 'amt-paid'">{{ rec.amt }}</text>
							</view>

							<view class="fill-row-mid">
								<text class="fill-state">{{ rec.state }}</text>
								<text class="fill-unit-txt" v-if="rec.unit.length > 0">{{ rec.unit }}</text>
							</view>

							<view class="fill-row-bot">
								<text class="fill-time">{{ rec.when }}</text>
								<text class="fill-action">{{ rec.action }}</text>
							</view>
						</view>

						<view class="empty-tip" v-if="recentFills.length == 0">
							<text class="empty-txt">暂无补能记录，点击右下角 ＋ 补记一笔</text>
						</view>
					</view>
				</view>

				<view class="page-end"></view>
			</view>
		</scroll-view>

		<!-- 🔘 右下角常驻悬浮按钮 (FAB) - 点击直接调用弹窗组件，默认弹出充电记账 -->
		<view class="fab-btn" :style="fabBox" @click="tapFab">
			<text class="fab-plus">＋</text>
		</view>

		<!-- 独立补能记账弹窗组件 -->
		<FillModal ref="fillModalRef" @success="load" />
	</view>
</template>

