		color: var(--text-muted, #94A3B8);
	}

	/* 分组列表容器 */
	.group-box {
		background-color: var(--card-bg, #FFFFFF);
		border: 1px solid var(--border-color, rgba(15, 23, 42, 0.08));
		border-radius: 18px;
		overflow: hidden;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
	}
	.menu-item {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
