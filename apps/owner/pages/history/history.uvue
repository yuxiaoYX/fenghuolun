<script setup>
	import { ref } from 'vue'
	import {
		ownerRequest,
		sessionOf,
		bounceIfAuthFailed,
		envelopeOk,
		envelopeData,
		dashNum,
		dashInt,
		themeClassOf,
		padBoxStyle,
		pageWrapStyle,
		applyThemeChrome
	} from '../../common/api.uts'

	type HistRow = {
		id : string
		when : string
		soc : string
		socVal : number
		fuel : string
		fuelVal : number
		rangeKm : string
		odo : string
		stale : boolean
	}

	const themeClass = ref(themeClassOf())
	const padStyle = ref('')
	const wrapStyle = ref('')
	const rows = ref<HistRow[]>([] as HistRow[])
	const note = ref('')
	const page = ref(1)
	const total = ref(0)
	const busy = ref(false)

	const pick = (obj, key) => {
		if (obj == null) {
			return null
		}
		return obj[key]
	}

	const load = async (reset : boolean) => {
		if (sessionOf() == '') {
			note.value = '尚未登录或绑定'
			rows.value = [] as HistRow[]
			return
		}
		if (reset == true) {
			page.value = 1
			rows.value = [] as HistRow[]
		}
		busy.value = true
		const res = await ownerRequest('GET', '/api/v1/owner/snapshots?page=' + page.value + '&pageSize=20', null)
		busy.value = false
		if (envelopeOk(res) == false) {
			if (reset == false && page.value > 1) {
				page.value = page.value - 1
			}
			if (bounceIfAuthFailed(res) == true) {
				return
			}
			note.value = '获取快照数据失败，请检查服务'
			return
		}
		const d = envelopeData(res)
		total.value = pick(d, 'total') == null ? 0 : parseInt('' + pick(d, 'total'))
		const items = pick(d, 'items')
		const next : HistRow[] = []
		if (reset == false) {
			let keep = 0
			while (keep < rows.value.length) {
				next.push(rows.value[keep])
				keep = keep + 1
			}
		}
		if (items != null) {
			let i = 0
			while (i < items.length) {
				const row = items[i]
				const fetched = pick(row, 'fetchedAt')
				const socNum = pick(row, 'socPct')
				const fuelNum = pick(row, 'fuelPct')
				let sVal = 0
				if (socNum != null) {
					sVal = Math.round(parseFloat('' + socNum))
					if (sVal < 0) {
						sVal = 0
					}
					if (sVal > 100) {
						sVal = 100
					}
				}
				next.push({
					id: '' + pick(row, 'id'),
					when: fetched == null ? '—' : '' + fetched,
					soc: dashInt(socNum, '%'),
					socVal: sVal,
					fuel: dashInt(fuelNum, '%'),
					fuelVal: fuelNum == null ? 0 : Math.max(0, Math.min(100, Math.round(parseFloat('' + fuelNum)))),
					rangeKm: dashNum(pick(row, 'evRangeKm'), ' km'),
					odo: dashNum(pick(row, 'odometerKm'), ' km'),
					stale: pick(row, 'stale') == true
				})
				i = i + 1
			}
		}
		rows.value = next
		if (next.length == 0) {
			note.value = '暂未收到官方云端车辆快照'
		} else {
			note.value = '私有服务已落库 ' + total.value + ' 条快照记录'
		}
	}

	const more = () => {
		page.value = page.value + 1
		load(false)
	}

	const applyChrome = () => {
		themeClass.value = themeClassOf()
		padStyle.value = padBoxStyle(false)
		wrapStyle.value = pageWrapStyle()
		applyThemeChrome()
	}

	onLoad(() => {
		applyChrome()
	})

	onShow(() => {
		applyChrome()
		load(true)
	})
</script>

<template>
	<view class="page-wrap" :class="themeClass" :style="wrapStyle">
		<scroll-view class="scroller" direction="vertical">
			<view class="pad" :style="padStyle">
				<!-- 顶部统计概览 -->
				<view class="stat-banner">
					<view class="stat-main">
						<text class="stat-title">车况快照归档</text>
						<text class="stat-sub">{{ note }}</text>
					</view>
					<view class="stat-badge">
						<text class="stat-num">{{ total }}</text>
						<text class="stat-unit">笔</text>
					</view>
				</view>

				<!-- 空状态 -->
				<view class="empty-card" v-if="rows.length == 0 && busy == false">
					<text class="empty-icon">📊</text>
					<text class="empty-title">暂无车况历史快照</text>
					<text class="empty-sub">后台定时任务或手动刷新车况后，将在此沉淀历史轨迹</text>
				</view>

				<!-- 快照数据卡片流 -->
				<view class="snap-list" v-if="rows.length > 0">
					<view class="snap-card" v-for="row in rows" :key="row.id">
						<!-- 卡片头部时间与状态 -->
						<view class="snap-head">
							<view class="snap-time-row">
								<text class="snap-clock-icon">🕒</text>
								<text class="snap-time-txt">{{ row.when }}</text>
							</view>
							<view class="tag-badge" :class="row.stale ? 'tag-warn' : 'tag-good'">
								<text class="tag-txt" :class="row.stale ? 'tag-txt-warn' : 'tag-txt-good'">
									{{ row.stale ? '数据陈旧' : '上报正常' }}
								</text>
							</view>
						</view>

						<!-- 卡片核心数据 4 列格 -->
						<view class="snap-grid">
							<!-- 电量列 -->
							<view class="snap-col">
								<text class="snap-k">剩余电量</text>
								<text class="snap-v-soc">{{ row.soc }}</text>
								<view class="snap-track">
									<view class="snap-fill" :style="'width:' + row.socVal + '%'"></view>
								</view>
							</view>
							<!-- 续航列 -->
							<view class="snap-col snap-col-border">
								<text class="snap-k">纯电续航</text>
								<text class="snap-v">{{ row.rangeKm }}</text>
							</view>
							<!-- 里程列 -->
							<view class="snap-col snap-col-border">
								<text class="snap-k">总里程</text>
								<text class="snap-v">{{ row.odo }}</text>
							</view>
							<!-- 油量列 -->
							<view class="snap-col snap-col-border">
								<text class="snap-k">剩余油量</text>
								<text class="snap-v-fuel">{{ row.fuel }}</text>
								<view class="snap-track">
									<view class="snap-fill snap-fill-fuel" :style="'width:' + row.fuelVal + '%'">
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>

				<!-- 分页加载 -->
				<view class="more-wrap" v-if="rows.length < total">
					<button class="more-btn" :disabled="busy" @click="more">
						{{ busy ? '正在加载...' : '加载更多历史快照 (' + rows.length + '/' + total + ')' }}
					</button>
				</view>

				<view class="all-done-wrap" v-if="rows.length >= total && rows.length > 0">
					<text class="all-done-txt">— 已加载全部历史快照 —</text>
				</view>

				<view class="page-end"></view>
			</view>
		</scroll-view>
	</view>
</template>

<style scoped>
