<script setup>
	import { ref } from 'vue'
	import {
		ownerRequest,
		sessionOf,
		dashInt,
		dashNum,
		dashFixed1,
		dashFixed2,
		dashUnknown,
		dashCoord,
		barWidthPct,
		snapshotStale,
		bounceIfAuthFailed,
		envelopeErrorCode,
		pingHealth,
		envelopeOk,
		envelopeData,
		relativeUpdateLine,
		chargeStatusText,
		themeClassOf,
		padBoxStyle,
		pageWrapStyle,
		applyThemeChrome
	} from '../../common/api.uts'

	const themeClass = ref(themeClassOf())
	const padStyle = ref('')
	const wrapStyle = ref('')

	// 车辆抬头
	const name = ref('家里的 L')
	const trimMeta = ref('310 增程版')
	const freshShort = ref('尚未更新')
	const stale = ref(false)
	const isSyncing = ref(false)
	const warn = ref('')

	// 车辆位置与温区
	const hasLoc = ref(false)
	const locTxt = ref('—')
	const cabinC = ref('—')
	const outsideC = ref('—')

	// 门窗与尾箱警示
	const hasAlert = ref(false)
	const alertText = ref('')
	const doorFLOpen = ref(false)
	const doorFROpen = ref(false)
	const doorRLOpen = ref(false)
	const doorRROpen = ref(false)
	const trunkOpen = ref(false)
	const winOpen = ref(false)

	// 四轮胎压与胎温 (异常颜色区分: 欠压<2.1 或 过压>2.8 标红)
	const tireFLBar = ref('—')
	const tireFLTemp = ref('—')
	const tireFLBad = ref(false)

	const tireFRBar = ref('—')
	const tireFRTemp = ref('—')
	const tireFRBad = ref(false)

	const tireRLBar = ref('—')
	const tireRLTemp = ref('—')
	const tireRLBad = ref(false)

	const tireRRBar = ref('—')
	const tireRRTemp = ref('—')
	const tireRRBad = ref(false)

	// 充电流光胶囊状态 (未插枪完全隐藏)
	const showCharging = ref(false)
	const chargeTitle = ref('充电中')
	const chargeDetail = ref('—')
	const chargeKw = ref('—')
	const chargeTargetNote = ref('补电进行中')

	// 双能量仪表
	const evKm = ref('—')
	const soc = ref('—')
	const socBar = ref('0%')
	const fuelKm = ref('—')
	const fuelPct = ref('—')
	const fuelBar = ref('0%')
	const totalKm = ref('—')
	const odoKm = ref('—')

	// 三电与蓄电池健康专区
	const v12 = ref('—')
	const v12Bad = ref(false)
	const v12Hint = ref('状态良好 · 防趴窝')
	const packVolt = ref('—')
	const packCurrent = ref('—')
	const fullCapKwh = ref('—')
	const fullCapNote = ref('基于充入度数与 SOC 跨度反推计算')

	const pick = (obj, key) => {
		if (obj == null) {
			return null
		}
		return obj[key]
	}

	const isClosed = (v) => {
		return dashUnknown(v) == 'closed'
	}

	const isOpen = (v) => {
		return dashUnknown(v) == 'open'
	}

	const resetVehicle = () => {
		name.value = '家里的 L'
		trimMeta.value = '尚未绑定'
		freshShort.value = '尚未更新'
		stale.value = false
		hasLoc.value = false
		locTxt.value = '—'
		cabinC.value = '—'
		outsideC.value = '—'
		doorFLOpen.value = false
		doorFROpen.value = false
		doorRLOpen.value = false
		doorRROpen.value = false
		trunkOpen.value = false
		winOpen.value = false
		hasAlert.value = false
		showCharging.value = false
		evKm.value = '—'
		soc.value = '—'
		socBar.value = '0%'
		fuelKm.value = '—'
		fuelPct.value = '—'
		fuelBar.value = '0%'
		totalKm.value = '—'
		odoKm.value = '—'
		v12.value = '—'
		v12Bad.value = false
		v12Hint.value = '暂无 12V 电压数据'
		packVolt.value = '—'
		packCurrent.value = '—'
		fullCapKwh.value = '—'
		warn.value = ''
	}

	const fillTire = (corner, setBar, setTemp, setBad) => {
		if (corner == null) {
			setBar('—')
			setTemp('—')
			setBad(false)
			return
		}
		const bVal = pick(corner, 'bar')
		const bar = dashFixed2(bVal, '')
		const tempN = pick(corner, 'tempC')
		const temp = tempN == null ? '—' : dashInt(tempN, '°C')
		setBar(bar)
		setTemp(temp)

		if (bVal != null) {
			const num = parseFloat('' + bVal)
			if (num > 0.5 && (num < 2.1 || num > 2.8)) {
				setBad(true)
				return
			}
		}
		setBad(false)
	}

	const load = async () => {
		if (sessionOf() == '') {
			resetVehicle()
			const up = await pingHealth()
			if (up == true) {
				trimMeta.value = '后端已通 · 去「我的」登录'
			} else {
				trimMeta.value = '后端未通 · 请先启动服务'
			}
			return
		}

		const res = await ownerRequest('GET', '/api/v1/owner/snapshot/latest', null)
		if (envelopeOk(res) == false) {
			if (bounceIfAuthFailed(res) == true) {
				resetVehicle()
				return
			}
			if (envelopeErrorCode(res) == 'token_invalid' || envelopeErrorCode(res) == 'unbound') {
				trimMeta.value = '官方凭据失效 · 到「我的」重新绑定'
				return
			}
			trimMeta.value = '服务未响应或会话失效'
			return
		}

		const d = envelopeData(res)

		// 1. 车辆基本信息 (干净纯粹，绝不展示底层 VIN 与 EP32)
		const nick = pick(d, 'nickname')
		name.value = nick != null && nick != '' ? '' + nick : '家里的 L'

		const modelName = pick(d, 'modelName')
		const trim = pick(d, 'trim')
		if (trim != null && trim != '') {
			trimMeta.value = '' + trim
		} else if (modelName != null && modelName != '') {
			trimMeta.value = '' + modelName
		} else {
			trimMeta.value = '哪吒 L'
		}

		// 2. 双能量仪表数据
		const power = pick(d, 'power')
		evKm.value = dashInt(pick(power, 'evRangeKm'), '')
		const socN = pick(power, 'socPct')
		soc.value = dashInt(socN, '%')
		socBar.value = barWidthPct(socN)
		totalKm.value = dashInt(pick(power, 'totalRangeKm'), '')

		const ext = pick(d, 'extender')
		let fuelN = pick(ext, 'fuelPct')
		if (fuelN == null) {
			fuelN = pick(power, 'fuelPct')
		}
		fuelPct.value = dashInt(fuelN, '%')
		fuelBar.value = barWidthPct(fuelN)

		if (pick(ext, 'fuelRangeKm') != null) {
			fuelKm.value = dashInt(pick(ext, 'fuelRangeKm'), '')
		} else {
			fuelKm.value = dashInt(pick(power, 'fuelRangeKm'), '')
		}
		odoKm.value = dashInt(pick(d, 'odometerKm'), '')

		// 3. 车辆温区与位置
		const climate = pick(d, 'climate')
		cabinC.value = dashFixed1(pick(climate, 'cabinC'), '°C')
		outsideC.value = dashFixed1(pick(climate, 'outsideC'), '°C')

		const loc = pick(d, 'location')
		const lng = pick(loc, 'lng')
		const lat = pick(loc, 'lat')
		if (lng != null && lat != null) {
			hasLoc.value = true
			locTxt.value = dashCoord(lat) + ', ' + dashCoord(lng)
		} else {
			hasLoc.value = false
			locTxt.value = '暂无位置数据'
		}

		// 4. 四门、尾箱与车窗状态（只有异常才警示）
		const body = pick(d, 'body')
		const doors = pick(body, 'doors')
		doorFLOpen.value = doors != null && isOpen(pick(doors, 'fl'))
		doorFROpen.value = doors != null && isOpen(pick(doors, 'fr'))
		doorRLOpen.value = doors != null && isOpen(pick(doors, 'rl'))
		doorRROpen.value = doors != null && isOpen(pick(doors, 'rr'))
		trunkOpen.value = doors != null && isOpen(pick(doors, 'trunk'))

		const wins = pick(body, 'windows')
		const winAnyOpen = wins != null && (
			isOpen(pick(wins, 'fl')) ||
			isOpen(pick(wins, 'fr')) ||
			isOpen(pick(wins, 'rl')) ||
			isOpen(pick(wins, 'rr')) ||
			isOpen(pick(wins, 'sunroof'))
		)
		winOpen.value = winAnyOpen

		const anyDoorOpen = doorFLOpen.value || doorFROpen.value || doorRLOpen.value || doorRROpen.value
		if (anyDoorOpen) {
			hasAlert.value = true
			if (doorFLOpen.value && !doorFROpen.value && !doorRLOpen.value && !doorRROpen.value) {
				alertText.value = '⚠️ 左前门未关好'
			} else {
				alertText.value = '⚠️ 车门未关好，请检查'
			}
		} else if (trunkOpen.value) {
			hasAlert.value = true
			alertText.value = '⚠️ 后备箱未关好'
		} else if (winOpen.value) {
			hasAlert.value = true
			alertText.value = '⚠️ 车窗或天窗开启中'
		} else {
			hasAlert.value = false
			alertText.value = ''
		}

		// 5. 四轮胎压与胎温
		const tires = pick(d, 'tires')
		fillTire(pick(tires, 'fl'), (v) => { tireFLBar.value = v }, (v) => { tireFLTemp.value = v }, (v) => { tireFLBad.value = v })
		fillTire(pick(tires, 'fr'), (v) => { tireFRBar.value = v }, (v) => { tireFRTemp.value = v }, (v) => { tireFRBad.value = v })
		fillTire(pick(tires, 'rl'), (v) => { tireRLBar.value = v }, (v) => { tireRLTemp.value = v }, (v) => { tireRLBad.value = v })
		fillTire(pick(tires, 'rr'), (v) => { tireRRBar.value = v }, (v) => { tireRRTemp.value = v }, (v) => { tireRRBad.value = v })

		// 6. 充电流光胶囊（未插枪完全隐藏）
		const plugged = pick(power, 'pluggedIn') == true
		const chargeRaw = dashUnknown(pick(power, 'chargeStatus'))
		const isCharging = chargeRaw == 'charging'
		showCharging.value = plugged || isCharging

		if (showCharging.value) {
			if (isCharging) {
				chargeTitle.value = '直流超快充进行中'
				chargeTargetNote.value = '当前已充至 ' + soc.value + ' (预计充至 95%)'
			} else {
				chargeTitle.value = '充电枪已插入'
				chargeTargetNote.value = '待机就绪 · 随时准备补能'
			}
			const powerKw = pick(power, 'chargePowerKw')
			if (powerKw != null) {
				chargeDetail.value = chargeStatusText(chargeRaw)
				chargeKw.value = parseFloat('' + powerKw).toFixed(1) + ' kW'
			} else {
				chargeDetail.value = chargeStatusText(chargeRaw)
				chargeKw.value = '— kW'
			}
		}

		// 7. 三电与蓄电池健康专区
		const b12Obj = pick(d, 'battery12v')
		const b12Volts = pick(b12Obj, 'volts')
		v12.value = dashFixed1(b12Volts, '')
		if (b12Volts == null) {
			v12Bad.value = false
			v12Hint.value = '暂无 12V 电压数据'
		} else if (parseFloat('' + b12Volts) < 12.2) {
			v12Bad.value = true
			v12Hint.value = '低于 12.2V · 建议及时上电保电'
		} else {
			v12Bad.value = false
			v12Hint.value = '状态饱满 · 防趴窝'
		}

		const batteryObj = pick(d, 'battery')
		packVolt.value = dashNum(pick(batteryObj, 'packVoltageV'), '')
		packCurrent.value = dashNum(pick(batteryObj, 'currentA'), '')

		// 获取可用容量反推
		const fillsRes = await ownerRequest('GET', '/api/v1/owner/fills', null)
		if (envelopeOk(fillsRes) == true) {
			const cap = pick(envelopeData(fillsRes), 'capacity')
			fullCapKwh.value = dashNum(pick(cap, 'kwh'), '')
			if (pick(cap, 'note') != null) {
				fullCapNote.value = '' + pick(cap, 'note')
			}
		}

		stale.value = snapshotStale(d)
		const reported = pick(d, 'reportedAt')
		const fetched = pick(d, 'fetchedAt')
		const at = reported != null && reported != '' ? '' + reported : (fetched != null ? '' + fetched : null)
		freshShort.value = relativeUpdateLine(at, stale.value)

		const warnings = pick(d, 'decodeWarnings')
		if (warnings != null && warnings.length > 0) {
			warn.value = '部分单位尚未对照实车，已标候选或隐藏。'
		} else {
			warn.value = ''
		}
	}

	const tapSync = async () => {
		if (sessionOf() == '') {
			uni.navigateTo({ url: '/pages/login/login' })
			return
		}
		if (isSyncing.value) {
			return
		}
		isSyncing.value = true
		uni.showToast({ title: '正在同步车辆快照…', icon: 'none' })

		const syncRes = await ownerRequest('POST', '/api/v1/owner/sync', null)
		isSyncing.value = false
		if (bounceIfAuthFailed(syncRes) == true) {
			return
		}
		if (envelopeErrorCode(syncRes) == 'token_invalid') {
			trimMeta.value = '官方绑定失效 · 到「我的」重新绑定'
			return
		}
		await load()
		if (envelopeOk(syncRes) == true) {
			uni.showToast({ title: '快照已同步', icon: 'none' })
		}
	}

	const applyChrome = () => {
		themeClass.value = themeClassOf()
		padStyle.value = padBoxStyle(true)
		wrapStyle.value = pageWrapStyle()
		applyThemeChrome()
	}

	onLoad(() => {
		applyChrome()
	})

	onShow(() => {
		applyChrome()
		load()
	})
</script>

<template>
	<view class="page-wrap" :class="themeClass" :style="wrapStyle">
		<scroll-view class="scroller" direction="vertical">
			<view class="pad" :style="padStyle">

				<!-- 顶部车辆抬头与一键同步按钮 (干净克制，无底层冗余代码) -->
				<view class="header-card">
					<view class="header-left">
						<view class="name-row">
							<text class="car-nick">{{ name }}</text>
							<text class="car-badge">{{ trimMeta }}</text>
						</view>
						<view class="fresh-row">
							<view class="fresh-dot" :class="stale ? 'fresh-dot-stale' : ''"></view>
							<text class="fresh-text" :class="stale ? 'fresh-text-stale' : ''">{{ freshShort }}</text>
						</view>
					</view>
					<view class="sync-btn" :class="isSyncing ? 'syncing' : ''" @click="tapSync">
						<text class="sync-icon">🔄</text>
					</view>
				</view>

				<!-- 解码提示 -->
				<text class="warn-banner" v-if="warn.length > 0">{{ warn }}</text>

				<!-- ⚡ 充电流光胶囊：插枪才浮现，未插枪完全隐藏 -->
				<view class="charge-capsule" v-if="showCharging">
					<view class="charge-top">
						<view class="charge-left">
							<view class="charge-bolt">
								<text class="bolt-icon">⚡</text>
							</view>
							<view class="charge-meta">
								<view class="charge-status-row">
									<text class="charge-status-title">{{ chargeTitle }}</text>
									<view class="charge-live-dot"></view>
								</view>
								<text class="charge-detail">{{ chargeDetail }}</text>
							</view>
						</view>
						<view class="charge-power">
							<text class="power-kw">{{ chargeKw }}</text>
							<text class="power-label">实时充入功率</text>
						</view>
					</view>
					<view class="charge-bot">
						<text class="charge-subnote">{{ chargeTargetNote }}</text>
						<text class="charge-soc-now">当前 SOC: {{ soc }}</text>
					</view>
				</view>

				<!-- 🚗【第一眼：车辆状态立体环视卡片】 (带对角折线 Leader line + 原厂车型 + 异常才提醒) -->
				<view class="cockpit-card status-card">
					<!-- 顶部极简位置与温区 -->
					<view class="status-top-bar">
						<view class="loc-wrap">
							<text class="loc-icon">📍</text>
							<text class="loc-text">{{ locTxt }}</text>
						</view>
						<view class="temp-wrap">
							<text class="temp-item">车内 <text class="temp-val">{{ cabinC }}</text></text>
							<text class="temp-sep">·</text>
							<text class="temp-item">车外 <text class="temp-val">{{ outsideC }}</text></text>
						</view>
					</view>

					<!-- 动态警示横幅：平时全关时绝不显示！只有开启时才居中浮现 -->
					<view class="alert-banner" v-if="hasAlert">
						<text class="alert-text">{{ alertText }}</text>
					</view>

					<!-- 车型图舞台与四角对角折线胎压 (Leader line) -->
					<view class="vehicle-stage">
						<!-- 原厂哪吒 L 俯视精模 (112px x 224px 标准比例) -->
						<view class="car-model-box">
							<image class="car-img" src="/static/vehicle/neta-l.png" mode="aspectFit"></image>

							<!-- 车门/尾箱/车窗开启光晕覆盖层 -->
							<view class="mask-door-fl" v-if="doorFLOpen"></view>
							<view class="mask-trunk" v-if="trunkOpen"></view>
							<view class="mask-win" v-if="winOpen"></view>
						</view>

						<!-- 左前胎压 (带折角斜线指向车轮) -->
						<view class="tire-anchor tire-fl">
							<view class="tire-readout tire-align-right">
								<view class="tire-bar-row">
									<text class="tire-val" :class="tireFLBad ? 'tire-bad' : 'tire-ok'">{{ tireFLBar }}</text>
									<text class="tire-unit">bar</text>
								</view>
								<view class="tire-line-divider"></view>
								<text class="tire-temp">{{ tireFLTemp }}</text>
							</view>
							<view class="leader-fl">
								<view class="leader-h" :class="tireFLBad ? 'line-bad' : 'line-ok'"></view>
								<view class="leader-diag-fl" :class="tireFLBad ? 'line-bad' : 'line-ok'"></view>
								<view class="leader-dot" :class="tireFLBad ? 'dot-bad' : 'dot-ok'"></view>
							</view>
						</view>

						<!-- 右前胎压 (带折角斜线指向车轮) -->
						<view class="tire-anchor tire-fr">
							<view class="leader-fr">
								<view class="leader-dot" :class="tireFRBad ? 'dot-bad' : 'dot-ok'"></view>
								<view class="leader-diag-fr" :class="tireFRBad ? 'line-bad' : 'line-ok'"></view>
								<view class="leader-h" :class="tireFRBad ? 'line-bad' : 'line-ok'"></view>
							</view>
							<view class="tire-readout tire-align-left">
								<view class="tire-bar-row">
									<text class="tire-val" :class="tireFRBad ? 'tire-bad' : 'tire-ok'">{{ tireFRBar }}</text>
									<text class="tire-unit">bar</text>
								</view>
								<view class="tire-line-divider"></view>
								<text class="tire-temp">{{ tireFRTemp }}</text>
							</view>
						</view>

						<!-- 左后胎压 -->
						<view class="tire-anchor tire-rl">
							<view class="tire-readout tire-align-right">
								<view class="tire-bar-row">
									<text class="tire-val" :class="tireRLBad ? 'tire-bad' : 'tire-ok'">{{ tireRLBar }}</text>
									<text class="tire-unit">bar</text>
								</view>
								<view class="tire-line-divider"></view>
								<text class="tire-temp">{{ tireRLTemp }}</text>
							</view>
							<view class="leader-rl">
								<view class="leader-h" :class="tireRLBad ? 'line-bad' : 'line-ok'"></view>
								<view class="leader-diag-rl" :class="tireRLBad ? 'line-bad' : 'line-ok'"></view>
								<view class="leader-dot" :class="tireRLBad ? 'dot-bad' : 'dot-ok'"></view>
							</view>
						</view>

						<!-- 右后胎压 -->
						<view class="tire-anchor tire-rr">
							<view class="leader-rr">
								<view class="leader-dot" :class="tireRRBad ? 'dot-bad' : 'dot-ok'"></view>
								<view class="leader-diag-rr" :class="tireRRBad ? 'line-bad' : 'line-ok'"></view>
								<view class="leader-h" :class="tireRRBad ? 'line-bad' : 'line-ok'"></view>
							</view>
							<view class="tire-readout tire-align-left">
								<view class="tire-bar-row">
									<text class="tire-val" :class="tireRRBad ? 'tire-bad' : 'tire-ok'">{{ tireRRBar }}</text>
									<text class="tire-unit">bar</text>
								</view>
								<view class="tire-line-divider"></view>
								<text class="tire-temp">{{ tireRRTemp }}</text>
							</view>
						</view>
					</view>

					<!-- 底部全关静默小字 (静默无痕) -->
					<view class="status-bot-bar" v-if="!hasAlert">
						<text class="normal-status-txt">✓ 全车门窗已闭锁 · 驻车待机中</text>
					</view>
				</view>

				<!-- 🔋【核心双能量条仪表盘】 -->
				<view class="cockpit-card energy-gauge-card">
					<view class="gauge-header">
						<text class="gauge-title">双能量续航仪表</text>
						<view class="gauge-meta-row">
							<text class="meta-item">综合 <text class="meta-em">{{ totalKm }}</text> km</text>
							<text class="meta-sep">|</text>
							<text class="meta-item">总里程 <text class="meta-em">{{ odoKm }}</text> km</text>
						</view>
					</view>

					<view class="gauge-grid">
						<!-- 纯电能量大卡 -->
						<view class="energy-tile">
							<view class="tile-top">
								<text class="tile-name">纯电续航</text>
								<text class="tile-pct elec-color">{{ soc }}</text>
							</view>
							<view class="tile-num-row">
								<text class="tile-big">{{ evKm }}</text>
								<text class="tile-unit">km</text>
							</view>
							<view class="track-bg">
								<view class="track-fill elec-bg" :style="'width:' + socBar"></view>
							</view>
						</view>

						<!-- 燃油能量大卡 -->
						<view class="energy-tile">
							<view class="tile-top">
								<text class="tile-name">燃油续航</text>
								<text class="tile-pct oil-color">{{ fuelPct }}</text>
							</view>
							<view class="tile-num-row">
								<text class="tile-big">{{ fuelKm }}</text>
								<text class="tile-unit">km</text>
							</view>
							<view class="track-bg">
								<view class="track-fill oil-bg" :style="'width:' + fuelBar"></view>
							</view>
						</view>
					</view>
				</view>

				<!-- ⚡【三电与蓄电池健康专区】 (带 border-l-4 高质感指示条) -->
				<view class="cockpit-card battery-health-card">
					<view class="b-head">
						<text class="b-title">三电与蓄电池健康</text>
						<text class="b-badge" :class="v12Bad ? 'b-badge-warn' : 'b-badge-good'">{{ v12Bad ? '小电瓶需注意' : '状态良好' }}</text>
					</view>

					<view class="b-grid">
						<!-- 12V 小电瓶监控 -->
						<view class="b-card" :class="v12Bad ? 'b-card-warn' : 'b-card-good'">
							<text class="b-k">12V 低压蓄电池</text>
							<view class="b-val-row">
								<text class="b-val" :class="v12Bad ? 'warn-color' : ''">{{ v12 }}</text>
								<text class="b-unit">V</text>
							</view>
							<text class="b-hint" :class="v12Bad ? 'warn-color' : 'good-color'">{{ v12Hint }}</text>
						</view>

						<!-- 动力电池组工作点 -->
						<view class="b-card b-card-good">
							<text class="b-k">动力电池组电压</text>
							<view class="b-val-row">
								<text class="b-val">{{ packVolt }}</text>
								<text class="b-unit">V</text>
							</view>
							<text class="b-hint">工作电流 {{ packCurrent }} A · 待机</text>
						</view>
					</view>

					<!-- 满电容量智能反推与只读说明 -->
					<view class="b-sub-box">
						<view class="b-sub-line">
							<text class="b-sub-k">满电可用容量反推</text>
							<text class="b-sub-v">{{ fullCapKwh }} kWh</text>
						</view>
						<text class="b-sub-p">{{ fullCapNote }}。SOH 绝不标注虚假 100%，以实际老化曲线为准。</text>
					</view>

					<!-- 私有只读守护原则提示 -->
					<view class="readonly-pill">
						<text class="shield-icon">🛡️</text>
						<text class="readonly-desc">私有只读守护账本，绝不向实车下发高危远程指令，保障实车电气安全。</text>
					</view>
				</view>

				<view class="page-end"></view>
			</view>
		</scroll-view>
	</view>
</template>

