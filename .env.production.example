# 给 install.sh / 1Panel 手动编排用。复制为 .env.production，不要提交真实值。
# 克隆仓库走 Docker Compose 时用根目录 .env.example → .env，见 docs/DEPLOYMENT.md。
FENGHUOLUN_TOKEN_KEK=
FENGHUOLUN_CORS_ORIGINS=https://example.com

# Optional: enable candidate /10 decoding only after comparing with the official app.
# FENGHUOLUN_NETA_SCALE=candidate

# Optional: only for the first boot of an empty database, then remove both values.
# FENGHUOLUN_ADMIN_BOOTSTRAP_USER=admin
# FENGHUOLUN_ADMIN_BOOTSTRAP_PASSWORD=
